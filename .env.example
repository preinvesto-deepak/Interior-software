# Copy this file to .env (dev) or .env.production (build), then fill in
# your real values. Vite only exposes vars prefixed VITE_ to the browser.

# Base URL of the PHP API (the /server folder). During local dev with PHP's
# built-in server this is typically http://localhost:8000; in production,
# wherever /server is deployed, e.g. https://yourdomain.com/server.
VITE_API_BASE_URL=http://localhost:8000

# Must match API_KEY in server/config.php exactly. Leave both blank only for
# local development on a machine nobody else can reach.
VITE_API_KEY=
